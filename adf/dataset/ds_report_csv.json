                "container": "refunds",
                "folderPath": "reports",
                "fileName": {
                    "value": "@dataset().fileName",
                    "type": "Expression"
                }
            },
            "columnDelimiter": ",",
            "quoteChar": "\"",
            "escapeChar": "\"",
            "firstRowAsHeader": true,
            "encodingName": "UTF-8"
        },
        "schema": []
    }
}
